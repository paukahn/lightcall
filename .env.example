# ---------------------------------------------------------------------------
# LightCall — пример конфигурации. Скопируйте в .env и заполните значения.
# .env НЕ коммитится (см. .gitignore / .dockerignore).
# ---------------------------------------------------------------------------

# Порт HTTP/WS сервера
PORT=3000

# ОБЯЗАТЕЛЬНО: токен доступа к админ-панели (/admin.html). Длинная случайная строка.
# Пример генерации: openssl rand -hex 32
ADMIN_TOKEN=change-me-to-a-long-random-secret

# Секрет для подписи сессионных токенов reconnect (HMAC).
# Необязателен — если не задан, генерируется случайно при старте (переживать
# рестарт не нужно: комнаты всё равно живут только в RAM).
# SESSION_SECRET=another-long-random-secret
# SESSION_TTL=43200            # сек, срок жизни сессионного токена (по умолч. 12ч)

# --- TURN (NAT traversal) -----------------------------------------------------
# ОБЯЗАТЕЛЬНО для работы под symmetric NAT / корпоративными файрволами.
# Общий секрет с coturn (--static-auth-secret). Пример: openssl rand -hex 32
TURN_SECRET=change-me-shared-with-coturn
TURN_REALM=lightcall.local

# Публичные адреса вашего TURN. Укажите домен/IP сервера coturn.
# UDP + TCP как минимум; при настроенном TLS добавьте turns:...:5349.
TURN_URLS=turn:your-domain-or-ip:3478?transport=udp,turn:your-domain-or-ip:3478?transport=tcp
# TURN_TTL=3600                # сек, срок жизни выдаваемых клиенту TURN-креденшелов

# Диапазон relay-портов coturn (узкий — под маленький VPS)
# TURN_MIN_PORT=49160
# TURN_MAX_PORT=49200

# Защита TURN от абуза (кража полосы)
# TURN_TOTAL_QUOTA=20          # макс. одновременных relay-сессий на сервере
# TURN_MAX_BPS=250000          # потолок байт/с на сессию (~2 Мбит/с)

# STUN-серверы (по умолчанию Google). Можно указать свой coturn как STUN.
# STUN_URLS=stun:stun.l.google.com:19302

# --- Telegram-мониторинг (опционально) ---------------------------------------
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# --- Тайминги устойчивости (опционально, значения по умолчанию разумны) -------
# HEARTBEAT_MS=30000           # период ping/pong
# GRACE_MS=30000               # окно на переподключение после обрыва
# PENDING_MS=60000             # TTL "стука" гостя без одобрения

# --- Rate limiting (опционально) ---------------------------------------------
# MAX_CONNS_PER_IP=25
# MAX_ROOMS_PER_IP_MIN=10
# MAX_ADMIN_FAILS=5
# TRUST_PROXY=false            # true, если сервер за реверс-прокси (читать X-Forwarded-For)
